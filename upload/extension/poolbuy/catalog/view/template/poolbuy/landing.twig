{#
  PoolBuy Wholesale B2B Landing Page
  Inspired by IndiaMART & Global Wholesale Leaders:
  - 1400px Balanced Canvas for standard desktop 100% zoom (Ctrl + 0)
  - Interactive "Post Buy Requirement" Instant RFQ Card
  - Active Momentum Buying Pool Showcase
  - 4-Column Verified B2B Wholesale Trust Strip
  - 12 Major B2B Category Mega-Grid with authentic imagery & subcategories
  - 8 Trending Factory Wholesale Products with Rupee (₹) pricing, volume tiers & direct MOQ add-to-cart
  - Collaborative Procurement 4-Step Guide & Closing Supplier/Buyer Portal CTA
#}

{# 1. Hero Section: Direct Sourcing & Instant RFQ #}
<section class="pb-hero-section pb-section">
  <div class="pb-container">
    <div class="row align-items-center g-4 g-xl-5">
      <div class="col-lg-7">
        <span class="pb-badge pb-badge--soft pb-mb-md">
          <i class="fa-solid fa-shield-halved text-success me-1"></i> India's Premier B2B Wholesale &amp; Group Buying Network
        </span>

        <h1 class="pb-display-lg pb-mb-md" style="font-family: var(--font-heading); font-size: clamp(34px, 4.2vw, 54px); line-height: 1.15; font-weight: 800;">
          Direct Manufacturer Sourcing<br/>
          <span style="color: #2563EB; font-weight: 800;">at True Factory Wholesale Prices</span>
        </h1>

        <p class="pb-body-lg pb-muted pb-mb-xl" style="max-width: 52rem; font-size: 1.15rem; line-height: 1.6;">
          Source directly from verified GST manufacturers and join collaborative buying pools. Pool wholesale order volume with other businesses across India to unlock tier-1 factory pricing with zero middleman markups.
        </p>

        <div class="d-flex flex-wrap gap-3 pb-mb-xl">
          <a class="pb-btn pb-btn--pill-filled pb-btn--lg" href="{{ marketplace }}">
            Browse Marketplace <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i>
          </a>
          <a class="pb-btn pb-btn--pill-outline pb-btn--lg" href="{{ contact }}">
            <i class="fa-solid fa-industry me-1"></i> Supply as Manufacturer
          </a>
        </div>

        <div class="pb-stats-strip d-flex flex-wrap gap-4 pt-3 border-top">
          <div>
            <div class="pb-display-md" style="font-size: 1.75rem; font-weight: 800; color: #0F294D;">₹250+ Cr</div>
            <div class="pb-label-sm pb-muted text-uppercase" style="letter-spacing: 0.05em; font-size: 0.8rem;">Sourced Volume</div>
          </div>
          <div class="border-start ps-4">
            <div class="pb-display-md" style="font-size: 1.75rem; font-weight: 800; color: #0F294D;">100%</div>
            <div class="pb-label-sm pb-muted text-uppercase" style="letter-spacing: 0.05em; font-size: 0.8rem;">GST ITC Invoices</div>
          </div>
          <div class="border-start ps-4">
            <div class="pb-display-md" style="font-size: 1.75rem; font-weight: 800; color: #0F294D;">19,000+</div>
            <div class="pb-label-sm pb-muted text-uppercase" style="letter-spacing: 0.05em; font-size: 0.8rem;">Freight Pincodes</div>
          </div>
          <div class="border-start ps-4">
            <div class="pb-display-md" style="font-size: 1.75rem; font-weight: 800; color: #0F294D;">Tier-1</div>
            <div class="pb-label-sm pb-muted text-uppercase" style="letter-spacing: 0.05em; font-size: 0.8rem;">Direct OEM Hubs</div>
          </div>
        </div>
      </div>

      <div class="col-lg-5">
        {# IndiaMART-style Interactive Post Requirement / RFQ Card #}
        <div class="pb-rfq-card">
          <div class="pb-rfq-header">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="pb-rfq-badge"><i class="fa-solid fa-bolt text-warning me-1"></i> INSTANT RFQ</span>
              <span class="text-success small fw-semibold"><i class="fa-solid fa-circle-check me-1"></i> Verified Manufacturers</span>
            </div>
            <h3 class="pb-rfq-title">Post Your Wholesale Requirement</h3>
            <p class="pb-rfq-sub">Get direct wholesale price quotes from top Indian manufacturers within 2 hours.</p>
          </div>

          <form action="{{ search_action }}" method="get" class="pb-rfq-form">
            <input type="hidden" name="route" value="product/search"/>
            <input type="hidden" name="language" value="{{ lang }}"/>
            
            <div class="mb-3">
              <label class="pb-rfq-label" for="rfq-product">Product / Raw Material Name *</label>
              <div class="input-group mb-1">
                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" id="rfq-product" name="search" class="form-control border-start-0" placeholder="e.g. Solar Panels, Submersible Pumps, FRP Vessels..." required/>
              </div>
              <div class="d-flex flex-wrap gap-1 mt-1">
                <span class="text-muted" style="font-size: 0.72rem;">Popular:</span>
                <button type="button" class="badge bg-light text-dark border text-decoration-none py-1 px-2" style="font-weight: 500; font-size: 0.72rem; cursor: pointer;" onclick="document.getElementById('rfq-product').value='Solar Panels';">Solar Panels</button>
                <button type="button" class="badge bg-light text-dark border text-decoration-none py-1 px-2" style="font-weight: 500; font-size: 0.72rem; cursor: pointer;" onclick="document.getElementById('rfq-product').value='Submersible Pump';">Pumps</button>
                <button type="button" class="badge bg-light text-dark border text-decoration-none py-1 px-2" style="font-weight: 500; font-size: 0.72rem; cursor: pointer;" onclick="document.getElementById('rfq-product').value='Cartons';">Cartons</button>
                <button type="button" class="badge bg-light text-dark border text-decoration-none py-1 px-2" style="font-weight: 500; font-size: 0.72rem; cursor: pointer;" onclick="document.getElementById('rfq-product').value='Pressure Vessels';">FRP Vessels</button>
              </div>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-7">
                <label class="pb-rfq-label" for="rfq-qty">Estimated Quantity *</label>
                <input type="number" id="rfq-qty" class="form-control" placeholder="e.g. 500" min="1" value="100"/>
              </div>
              <div class="col-5">
                <label class="pb-rfq-label" for="rfq-unit">Unit Type</label>
                <select id="rfq-unit" class="form-select">
                  <option value="pcs">Pieces</option>
                  <option value="boxes">Boxes</option>
                  <option value="meters">Meters</option>
                  <option value="kg">Kg / Tons</option>
                </select>
              </div>
            </div>

            <div class="mb-3">
              <label class="pb-rfq-label" for="rfq-city">Destination City / Pincode</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-location-dot text-muted"></i></span>
                <input type="text" id="rfq-city" class="form-control border-start-0" placeholder="e.g. Mumbai, 400001"/>
              </div>
            </div>

            <button type="submit" class="pb-btn pb-btn--pill-filled w-100 py-2 pb-rfq-submit">
              <i class="fa-solid fa-paper-plane me-2"></i> Get Wholesale Quotes Now
            </button>
            <div class="text-center mt-2">
              <span class="text-muted" style="font-size: 0.78rem;">
                <i class="fa-solid fa-lock text-success me-1"></i> No spam &bull; Direct factory connections &bull; 100% Free
              </span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

{# 2. Live Procurement Momentum Pool #}
{% if featured %}
<section class="pb-container pb-mb-2xl pb-reveal">
  <div class="pb-featured-pool-banner">
    <div class="row align-items-center g-4">
      <div class="col-lg-3 col-md-4 text-center">
        <a href="{{ featured.href }}">
          <img src="{{ featured.thumb }}" alt="{{ featured.title|escape }}" class="pb-featured-pool-img img-fluid"/>
        </a>
      </div>
      <div class="col-lg-6 col-md-8">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge" style="background: #0F294D; color: #FFFFFF; font-weight: 700; padding: 6px 12px; border-radius: 6px;"><i class="fa-solid fa-fire text-warning me-1"></i> LIVE GROUP POOL</span>
          {% if featured.is_urgent %}
            <span class="badge bg-warning text-dark"><i class="fa-regular fa-clock me-1"></i> Closing Soon</span>
          {% endif %}
          <span class="text-muted small"><i class="fa-solid fa-tag me-1"></i> Save up to 40% vs Retail</span>
        </div>
        <h3 class="pb-featured-pool-title mb-2">
          <a href="{{ featured.href }}" class="text-dark text-decoration-none">{{ featured.title|escape }}</a>
        </h3>
        <p class="text-muted small mb-3">{{ featured.hint|escape }}</p>
        
        <div class="pb-progress-wrap mb-2">
          <div class="d-flex justify-content-between small fw-semibold mb-1">
            <span>Pool Target: {{ featured.moq_target }} {{ featured.unit_label|escape }}</span>
            <span class="fw-bold" style="color: #2563EB;">{{ text_filled|format(featured.reserved_qty, featured.moq_target) }} ({{ featured.fill }}%)</span>
          </div>
          <div class="progress" style="height: 10px; border-radius: 6px; background-color: #E2E8F0;">
            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: {{ featured.fill }}%; background: linear-gradient(90deg, #06B6D4 0%, #2563EB 100%);" aria-valuenow="{{ featured.fill }}" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
        </div>
      </div>
      <div class="col-lg-3 text-lg-end text-start">
        <div class="pb-price-callout mb-3">
          <div class="text-muted small text-uppercase font-weight-bold">Pool Wholesale Price</div>
          <div class="display-6 fw-bold" style="color: #0F294D;">{{ featured.unit_price_text }}</div>
          {% if featured.has_retail_saving %}
            <div class="text-muted small text-decoration-line-through">Retail: {{ featured.retail_price_text }}</div>
          {% endif %}
        </div>
        <a href="{{ featured.href }}" class="pb-btn pb-btn--pill-filled w-100 text-center">
          Join This Pool &rsaquo;
        </a>
      </div>
    </div>
  </div>
</section>
{% endif %}

