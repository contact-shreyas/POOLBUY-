  <div class="rabreez-trust-card">
    <div class="rabreez-trust-item">
      <div class="rabreez-trust-icon"><i class="fa-solid fa-certificate"></i></div>
      <div class="rabreez-trust-text">
        <span class="rabreez-trust-title">GST Verified Network</span>
        <span class="rabreez-trust-sub">100% Tax Compliant Indian Manufacturers</span>
      </div>
    </div>
    <div class="rabreez-trust-item">
      <div class="rabreez-trust-icon"><i class="fa-solid fa-truck-fast"></i></div>
      <div class="rabreez-trust-text">
        <span class="rabreez-trust-title">Pan-India Freight Logistics</span>
        <span class="rabreez-trust-sub">Doorstep delivery for bulk consignments</span>
      </div>
    </div>
    <div class="rabreez-trust-item">
      <div class="rabreez-trust-icon"><i class="fa-solid fa-shield-halved"></i></div>
      <div class="rabreez-trust-text">
        <span class="rabreez-trust-title">Escrow Safe Payments</span>
        <span class="rabreez-trust-sub">Funds protected until quality verification</span>
      </div>
    </div>
    <div class="rabreez-trust-item">
      <div class="rabreez-trust-icon"><i class="fa-solid fa-headset"></i></div>
      <div class="rabreez-trust-text">
        <span class="rabreez-trust-title">Key Account Manager</span>
        <span class="rabreez-trust-sub">Personal bulk procurement support</span>
      </div>
    </div>
  </div>
</section>

{# 4. 12 Major B2B Wholesale Categories #}
{% if categories %}
<section class="pb-container pb-section pb-reveal" style="padding-top: 1rem;">
  <div class="d-flex flex-wrap justify-content-between align-items-end pb-mb-xl">
    <div>
      <span class="pb-badge pb-badge--soft pb-mb-xs">
        <i class="fa-solid fa-layer-group text-primary me-1"></i> INDUSTRY VERTICALS
      </span>
      <h2 class="pb-display-lg mb-1" style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800;">
        Explore Wholesale Industries &amp; Categories
      </h2>
      <p class="pb-body-md pb-muted mb-0">Direct factory supply lines across 12 primary B2B wholesale manufacturing sectors</p>
    </div>
    <a href="{{ categories_all }}" class="pb-btn pb-btn--pill-outline mt-3 mt-md-0">
      View All 12 Industries <i class="fa-solid fa-arrow-right ms-1"></i>
    </a>
  </div>

  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 row-cols-xxl-6 g-4 pb-category-grid">
    {% for category in categories %}
      <div class="col">
        <div class="pb-cat-card h-100">
          <a href="{{ category.href }}" class="pb-cat-card-img-wrap text-decoration-none">
            <img src="{{ category.image }}" alt="{{ category.name|escape }}" class="pb-cat-card-img" loading="lazy"/>
            <span class="pb-cat-card-count">{{ category.product_total }} Products</span>
          </a>
          <div class="pb-cat-card-content">
            <h4 class="pb-cat-card-title">
              <a href="{{ category.href }}">{{ category.name }}</a>
            </h4>
            {% if category.subcategories %}
              <div class="pb-cat-card-subs">
                {% for sub in category.subcategories %}
                  <a href="{{ sub.href }}" class="pb-sub-pill">{{ sub.name }}</a>
                {% endfor %}
              </div>
            {% endif %}
            <a href="{{ category.href }}" class="pb-cat-card-explore">
              Browse Sector <i class="fa-solid fa-chevron-right ms-1"></i>
            </a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# 5. 8 Trending Factory Wholesale Products #}
{% if trending_products %}
<section class="pb-section pb-reveal" style="background: #F8FAFC; border-block: 1px solid #E2E8F0; padding-block: 3.5rem;">
  <div class="pb-container">
    <div class="d-flex flex-wrap justify-content-between align-items-end pb-mb-xl">
      <div>
        <span class="pb-badge pb-badge--soft pb-mb-xs">
          <i class="fa-solid fa-bolt text-primary me-1"></i> FACTORY DIRECT DEALS
        </span>
        <h2 class="pb-display-lg mb-1" style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800;">
          Trending Wholesale Products &amp; Bulk Deals
        </h2>
        <p class="pb-body-md pb-muted mb-0">High-volume orders at verified tier-1 manufacturer rates</p>
      </div>
      <a href="{{ marketplace }}" class="pb-btn pb-btn--pill-outline mt-3 mt-md-0">
        Explore All Wholesale Deals <i class="fa-solid fa-arrow-right ms-1"></i>
      </a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 pb-trending-grid">
      {% for product in trending_products %}
        <div class="col">
          <div class="pb-product-card h-100">
            <a href="{{ product.href }}" class="pb-product-img-wrap text-decoration-none">
              <img src="{{ product.thumb }}" alt="{{ product.name|escape }}" class="pb-product-img" loading="lazy"/>
              <span class="pb-product-badge"><i class="fa-solid fa-check-double me-1"></i> Verified Factory</span>
            </a>
            <div class="pb-product-body">
              <div class="pb-product-moq-tag">MOQ: {{ product.minimum }} units</div>
              <h5 class="pb-product-name">
                <a href="{{ product.href }}" title="{{ product.name|escape }}">{{ product.name|escape }}</a>
              </h5>
              
              <div class="pb-product-price-row">
                <div class="pb-product-price">{{ product.price }}</div>
                {% if product.tier_badge %}
                  <div class="pb-product-tier-badge">{{ product.tier_badge }}</div>
                {% endif %}
              </div>

              <div class="pb-product-actions">
                <a href="{{ product.href }}" class="pb-btn-action-view">View Specs</a>
                <button type="button" class="pb-btn-action-cart" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" title="Add Minimum Order to Cart">
                  <i class="fa-solid fa-cart-plus me-1"></i> Add MOQ
                </button>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# 6. How Collaborative B2B Procurement Works #}
<section id="how-it-works" class="pb-container pb-section pb-reveal">
  <div class="pb-text-center pb-mb-2xl">
    <span class="pb-badge pb-badge--soft pb-mb-xs">
      <i class="fa-solid fa-handshake text-primary me-1"></i> COLLABORATIVE SOURCING
    </span>
    <h2 class="pb-display-lg pb-mb-xs" style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800;">{{ text_how_title }}</h2>
    <div class="rabreez-heading-flourish"><span>&#10022;</span></div>
    <p class="pb-body-lg pb-muted" style="max-width: 44rem; margin-inline: auto;">{{ text_how_body }}</p>
  </div>

  <div class="pb-grid pb-grid-4">
    {% for step in steps %}
      <div class="rabreez-step-card">
        <div class="pb-step__icon pb-step__icon--{{ loop.index }}"><i class="{{ step.icon }}" aria-hidden="true"></i></div>
        <h3 class="pb-headline-sm pb-mb-sm" style="font-family: var(--font-heading);">{{ step.title }}</h3>
        <p class="pb-body-md pb-muted pb-mb-0">{{ step.body }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{# 7. Closing Supplier / Buyer Portal CTA #}
<section class="pb-container pb-section pb-reveal">
  <div class="pb-cta rabreez-cta-banner">
    <h2 class="pb-display-lg pb-mb-md" style="font-family: var(--font-heading); color: #FFFFFF; font-size: clamp(28px, 3.5vw, 42px); font-weight: 800;">
      Grow Your Wholesale Business with PoolBuy
    </h2>
    <div class="rabreez-heading-flourish rabreez-heading-flourish--light"><span>&#10022;</span></div>
    <p class="pb-body-lg pb-cta__lead pb-mb-xl" style="max-width: 44rem; margin-inline: auto; color: rgba(255, 255, 255, 0.9);">
      Whether you are an established Indian manufacturer seeking high-volume bulk contracts or a business seeking tier-1 factory pricing, PoolBuy provides the secure infrastructure you need.
    </p>
    <div class="pb-flex pb-wrap pb-justify-center pb-gap-md">
      <a class="pb-btn pb-btn--pill-gold pb-btn--lg" href="{{ register }}">Create Free Buyer Account</a>
      <a class="pb-btn pb-btn--pill-outline-light pb-btn--lg" href="{{ contact }}">Register as Manufacturer</a>
    </div>
  </div>
</section>
