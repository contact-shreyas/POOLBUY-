{{ header }}
<div id="product-category" class="pb-container py-4">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    <div id="content" class="col">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      {% if image or description %}
        <div class="row">
          {% if image %}
            <div class="col-3"><img src="{{ image }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-thumbnail"/></div>
          {% endif %}
          {% if description %}
            <div class="col-9">{{ description }}</div>
          {% endif %}
        </div>
        <hr/>
      {% endif %}

      {% if categories %}
        <div class="mb-4 p-3 bg-white border rounded" style="border-color: #E2E8F0 !important;">
          <div class="fw-bold text-uppercase small text-muted mb-2" style="font-size: 0.78rem; letter-spacing: 0.05em;">
            <i class="fa-solid fa-layer-group me-1 text-primary"></i> Subcategories &amp; Specialized Verticals:
          </div>
          <div class="d-flex flex-wrap gap-2">
            {% for category in categories %}
              <a href="{{ category.href }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 bg-white text-dark text-decoration-none" style="font-weight: 500; font-size: 0.82rem; border-color: #CBD5E1;">
                {{ category.name }}
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if products %}
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 mb-4 rounded bg-white border" style="border-color: #E2E8F0 !important;">
          <div class="d-flex align-items-center gap-2">
            <span class="text-muted small fw-semibold">View:</span>
            <div class="btn-group btn-group-sm">
              <button type="button" id="button-grid" class="btn btn-outline-primary active" data-bs-toggle="tooltip" title="{{ button_grid }}"><i class="fa-solid fa-table-cells"></i></button>
              <button type="button" id="button-list" class="btn btn-outline-secondary" data-bs-toggle="tooltip" title="{{ button_list }}"><i class="fa-solid fa-table-list"></i></button>
            </div>
            <a href="{{ compare }}" id="compare-total" class="btn btn-sm btn-outline-secondary ms-2" style="font-size: 0.8rem; border-color: #CBD5E1;"><i class="fa-solid fa-arrow-right-arrow-left me-1"></i> <span class="d-none d-sm-inline">{{ text_compare }}</span></a>
          </div>
          <div class="d-flex align-items-center gap-3 ms-auto">
            <div class="d-flex align-items-center gap-2">
              <label for="input-sort" class="text-muted small fw-semibold text-nowrap mb-0">{{ text_sort }}:</label>
              <select id="input-sort" class="form-select form-select-sm" style="min-width: 140px;" onchange="location = this.value;">
                {% for sorts in sorts %}
                  <option value="{{ sorts.href }}"{% if sorts.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ sorts.text }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="d-flex align-items-center gap-2">
              <label for="input-limit" class="text-muted small fw-semibold text-nowrap mb-0">{{ text_limit }}:</label>
              <select id="input-limit" class="form-select form-select-sm" style="width: 80px;" onchange="location = this.value;">
                {% for limits in limits %}
                  <option value="{{ limits.href }}"{% if limits.value == limit %} selected{% endif %}>{{ limits.text }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
        </div>

        <div id="product-list" class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-4">
          {% for product in products %}
            <div class="col mb-3">{{ product }}</div>
          {% endfor %}
        </div>

        <div class="row">
          <div class="col-sm-6 text-start">{{ pagination }}</div>
          <div class="col-sm-6 text-end">{{ results }}</div>
        </div>
      {% endif %}
      {% if not categories and not products %}
        <p>{{ text_no_results }}</p>
        <div class="text-end"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
